{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:socios:portable-theme:v1",
  "title": "Socios Portable Theme v1",
  "description": "Portable, tool-agnostic design-intent theme accepted by the Socios design-system editor (+ Upload theme). It is validated by mirror-overlay/theme-system.js and then mapped onto Socios tokens and scoped CSS rules. It intentionally does not use Socios token names.",
  "type": "object",
  "required": [
    "themeVersion"
  ],
  "properties": {
    "themeVersion": {
      "enum": [
        1,
        "1"
      ],
      "description": "Schema version. Canonical value is the number 1; the runtime coerces with Number(), so \"1\" is also accepted."
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "name": {
      "$ref": "#/definitions/family",
      "description": "Legacy top-level fallback for meta.name. Canonical portable themes should use meta.name."
    },
    "colors": {
      "$ref": "#/definitions/colors"
    },
    "typography": {
      "$ref": "#/definitions/typography"
    },
    "shape": {
      "$ref": "#/definitions/shape"
    },
    "spacing": {
      "$ref": "#/definitions/spacing"
    },
    "buttons": {
      "$ref": "#/definitions/buttons"
    },
    "cards": {
      "$ref": "#/definitions/cards"
    },
    "effects": {
      "$ref": "#/definitions/effects"
    },
    "fonts": {
      "$ref": "#/definitions/fonts"
    },
    "assets": {
      "$ref": "#/definitions/assets"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "meta"
          ],
          "properties": {
            "meta": {
              "type": "object",
              "required": [
                "name"
              ]
            }
          }
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "colors"
          ],
          "properties": {
            "colors": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "typography"
          ],
          "properties": {
            "typography": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "buttons"
          ],
          "properties": {
            "buttons": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "required": [
            "cards"
          ],
          "properties": {
            "cards": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "definitions": {
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^;{}\"]*\\S[^;{}\"]*$",
      "description": "CSS font family name/stack. Trimmed; no semicolon, braces or double quotes; may include commas."
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "description": "Hex colour. #RGB is expanded to #RRGGBB and the result is lowercased."
    },
    "paint": {
      "anyOf": [
        {
          "$ref": "#/definitions/hexColor"
        },
        {
          "type": "string",
          "pattern": "^[Tt][Rr][Aa][Nn][Ss][Pp][Aa][Rr][Ee][Nn][Tt]$"
        }
      ],
      "description": "Hex colour or the keyword transparent (case-insensitive). Only buttons/cards accept transparent."
    },
    "size": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px|rem|em|%)?$"
        }
      ],
      "description": "Number (interpreted as px) or CSS length in px/rem/em/%. Bare numeric strings are treated as px."
    },
    "radius": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:px|rem|em|%)?$"
        }
      ],
      "description": "Number (px) or CSS length. Numeric/px values are clamped to >= 0; other units pass through."
    },
    "weight": {
      "type": "number",
      "minimum": 100,
      "maximum": 900,
      "description": "Font weight 100–900. The runtime rounds to the nearest 100 (450 → 500)."
    },
    "lineHeight": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^(?:\\d*\\.?\\d+|(?:-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))(?:px|rem|em|%))$"
        }
      ],
      "description": "Unitless multiplier, numeric string, or CSS length."
    },
    "letterSpacing": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "pattern": "^(?:\\d*\\.?\\d+|(?:-?(?:\\d+(?:\\.\\d+)?|\\.\\d+))(?:px|rem|em|%))$"
        }
      ],
      "description": "Number (converted to em) or CSS length. Numeric strings are passed through unchanged by the current runtime."
    },
    "shadowString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^;{}]*\\S[^;{}]*$",
      "description": "Raw CSS box-shadow or the keyword none. Cannot contain ; { }."
    },
    "shadowObject": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X offset in px. Default 0."
        },
        "y": {
          "type": "number",
          "description": "Y offset in px. Default 4."
        },
        "blur": {
          "type": "number",
          "description": "Blur radius in px. Default 6."
        },
        "spread": {
          "type": "number",
          "description": "Spread in px. Default -1."
        },
        "color": {
          "$ref": "#/definitions/hexColor",
          "description": "Shadow colour. Default #000000."
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity 0–1. Values are clamped; default 0.1."
        }
      },
      "additionalProperties": true,
      "description": "Structured shadow. Missing fields use the documented defaults."
    },
    "shadow": {
      "anyOf": [
        {
          "$ref": "#/definitions/shadowString"
        },
        {
          "$ref": "#/definitions/shadowObject"
        }
      ]
    },
    "blur": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^;{}]*\\S[^;{}]*$",
      "description": "CSS backdrop-filter value, e.g. blur(16px). Cannot contain ; { }."
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/family",
          "description": "Required theme name (trimmed, max 80 chars on save)."
        },
        "description": {
          "type": "string",
          "description": "Optional human-readable summary."
        }
      },
      "additionalProperties": true,
      "description": "Identity block. name is required unless the legacy top-level name is used."
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/definitions/hexColor",
          "description": "Brand / primary action colour."
        },
        "primaryHover": {
          "$ref": "#/definitions/hexColor",
          "description": "Pressed/hover brand colour."
        },
        "primarySubtle": {
          "$ref": "#/definitions/hexColor",
          "description": "Tinted brand surface."
        },
        "background": {
          "$ref": "#/definitions/hexColor",
          "description": "App/screen background."
        },
        "surface": {
          "$ref": "#/definitions/hexColor",
          "description": "Cards, inputs and containers."
        },
        "strongSurface": {
          "$ref": "#/definitions/hexColor",
          "description": "Inverse / feature surface."
        },
        "primaryText": {
          "$ref": "#/definitions/hexColor",
          "description": "Primary copy and icons."
        },
        "secondaryText": {
          "$ref": "#/definitions/hexColor",
          "description": "Secondary copy and unselected icons."
        },
        "mutedText": {
          "$ref": "#/definitions/hexColor",
          "description": "Disabled copy, icons and borders."
        },
        "textOnPrimary": {
          "$ref": "#/definitions/hexColor",
          "description": "Text/icon on the primary colour."
        },
        "textOnStrongSurface": {
          "$ref": "#/definitions/hexColor",
          "description": "Text/icon on strongSurface."
        },
        "border": {
          "$ref": "#/definitions/hexColor",
          "description": "Dividers and default borders."
        },
        "positive": {
          "$ref": "#/definitions/hexColor",
          "description": "Success / price-up."
        },
        "negative": {
          "$ref": "#/definitions/hexColor",
          "description": "Error / price-down."
        },
        "warning": {
          "$ref": "#/definitions/hexColor",
          "description": "Warning / attention."
        }
      },
      "additionalProperties": true,
      "description": "Design-intent colour roles. Only the 15 declared keys are mapped; unknown keys are ignored."
    },
    "typographyRole": {
      "type": "object",
      "properties": {
        "weight": {
          "$ref": "#/definitions/weight"
        },
        "lineHeight": {
          "$ref": "#/definitions/lineHeight"
        },
        "letterSpacing": {
          "$ref": "#/definitions/letterSpacing"
        },
        "family": {
          "$ref": "#/definitions/family"
        },
        "fontFamily": {
          "$ref": "#/definitions/family",
          "description": "Alias for family. family wins when both are present."
        }
      },
      "additionalProperties": true
    },
    "typography": {
      "type": "object",
      "properties": {
        "display": {
          "$ref": "#/definitions/typographyRole",
          "description": "Display/hero typography."
        },
        "heading": {
          "$ref": "#/definitions/typographyRole",
          "description": "Section headings."
        },
        "body": {
          "$ref": "#/definitions/typographyRole",
          "description": "Body copy."
        },
        "cta": {
          "$ref": "#/definitions/typographyRole",
          "description": "Buttons and calls to action."
        }
      },
      "additionalProperties": true,
      "description": "Four typographic roles. Each role may set weight, lineHeight, letterSpacing and family."
    },
    "shape": {
      "type": "object",
      "properties": {
        "buttonRadius": {
          "$ref": "#/definitions/radius",
          "description": "Button corner radius."
        },
        "cardRadius": {
          "$ref": "#/definitions/radius",
          "description": "Standard card corner radius."
        },
        "largeCardRadius": {
          "$ref": "#/definitions/radius",
          "description": "Large/feature card corner radius."
        },
        "inputRadius": {
          "$ref": "#/definitions/radius",
          "description": "Input/textarea/select corner radius."
        }
      },
      "additionalProperties": true,
      "description": "Corner-radius foundations."
    },
    "spacing": {
      "type": "object",
      "properties": {
        "xs": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-xxxs."
        },
        "sm": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-xxs."
        },
        "md": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-sm."
        },
        "lg": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-lg."
        },
        "xl": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-xl and --page-gutter."
        },
        "2xl": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-xxl."
        },
        "3xl": {
          "$ref": "#/definitions/size",
          "description": "Maps to --space-xxxl."
        }
      },
      "additionalProperties": true,
      "description": "Seven-step spacing scale. Intermediate --space-xs and --space-md are derived midpoints."
    },
    "button": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/paint",
          "description": "Base background. Also clears background-image for primary."
        },
        "hover": {
          "$ref": "#/definitions/paint",
          "description": "Hover background. The only directly supported component state."
        },
        "text": {
          "$ref": "#/definitions/paint",
          "description": "Text/icon colour."
        },
        "border": {
          "$ref": "#/definitions/paint",
          "description": "Border colour. Secondary also gets 1px solid width/style."
        },
        "radius": {
          "$ref": "#/definitions/radius",
          "description": "Border radius."
        },
        "shadow": {
          "$ref": "#/definitions/shadow",
          "description": "Box shadow."
        }
      },
      "additionalProperties": true
    },
    "buttons": {
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/definitions/button",
          "description": "Primary CTA override (fixed primary-button selector)."
        },
        "secondary": {
          "$ref": "#/definitions/button",
          "description": "Secondary CTA override (fixed secondary-button selector)."
        }
      },
      "additionalProperties": true,
      "description": "Component overrides for the two button roles."
    },
    "card": {
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/paint",
          "description": "Background. Feature cards also clear background-image."
        },
        "text": {
          "$ref": "#/definitions/paint",
          "description": "Text/icon colour."
        },
        "border": {
          "$ref": "#/definitions/paint",
          "description": "Border colour. Standard cards also get 1px solid width/style."
        },
        "radius": {
          "$ref": "#/definitions/radius",
          "description": "Border radius."
        },
        "shadow": {
          "$ref": "#/definitions/shadow",
          "description": "Box shadow."
        }
      },
      "additionalProperties": true
    },
    "cards": {
      "type": "object",
      "properties": {
        "standard": {
          "$ref": "#/definitions/card",
          "description": "Standard card override."
        },
        "feature": {
          "$ref": "#/definitions/card",
          "description": "Feature/inverse card override."
        }
      },
      "additionalProperties": true,
      "description": "Component overrides for the two card roles."
    },
    "effects": {
      "type": "object",
      "properties": {
        "shadow": {
          "$ref": "#/definitions/shadow",
          "description": "Global shadow. The keyword none zeroes the sm/md/lg/xl shadow tokens; any other value is applied to .shadow-* elements."
        },
        "blur": {
          "$ref": "#/definitions/blur",
          "description": "Applied to [class*=\"backdrop-blur\"]."
        }
      },
      "additionalProperties": true,
      "description": "Global effects."
    },
    "fontEntry": {
      "anyOf": [
        {
          "$ref": "#/definitions/family"
        },
        {
          "type": "object",
          "required": [
            "family"
          ],
          "properties": {
            "family": {
              "$ref": "#/definitions/family"
            },
            "role": {
              "enum": [
                "display",
                "heading",
                "body",
                "cta"
              ],
              "description": "Optional role. Missing role is accepted but ignored."
            }
          },
          "additionalProperties": true
        }
      ],
      "description": "Family name or { family, role } registration."
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/fontEntry"
      },
      "description": "Registered families. body sets --font-sans; display/heading/cta add scoped font-family rules; entries without a role are ignored."
    },
    "assets": {
      "type": [
        "object",
        "array"
      ],
      "description": "Opaque asset manifest. Accepted and preserved by validation but not mapped by the portable theme mapper."
    }
  },
  "examples": [
    {
      "themeVersion": 1,
      "meta": {
        "name": "Complete Portable Theme Example",
        "description": "Fully populated themeVersion 1 file: every supported foundation and component override."
      },
      "colors": {
        "primary": "#3137ff",
        "primaryHover": "#252ae5",
        "primarySubtle": "#e7e9ff",
        "background": "#f3f6ff",
        "surface": "#ffffff",
        "strongSurface": "#171c86",
        "primaryText": "#090a12",
        "secondaryText": "#666a82",
        "mutedText": "#979bad",
        "textOnPrimary": "#ffffff",
        "textOnStrongSurface": "#f4f2ff",
        "border": "#e7e9f0",
        "positive": "#0f9d58",
        "negative": "#d93025",
        "warning": "#b26a00"
      },
      "typography": {
        "display": {
          "weight": 800,
          "lineHeight": 0.95,
          "letterSpacing": "-0.03em",
          "family": "Space Grotesk"
        },
        "heading": {
          "weight": 700,
          "lineHeight": 1.15,
          "letterSpacing": "-0.01em",
          "family": "Space Grotesk"
        },
        "body": {
          "weight": 400,
          "lineHeight": 1.45,
          "letterSpacing": "0em",
          "family": "Inter"
        },
        "cta": {
          "weight": 600,
          "lineHeight": 1,
          "letterSpacing": "0.01em",
          "family": "Inter"
        }
      },
      "shape": {
        "buttonRadius": 999,
        "cardRadius": 16,
        "largeCardRadius": 20,
        "inputRadius": 12
      },
      "spacing": {
        "xs": 4,
        "sm": 8,
        "md": 16,
        "lg": 24,
        "xl": 32,
        "2xl": 48,
        "3xl": 72
      },
      "buttons": {
        "primary": {
          "background": "#3137ff",
          "hover": "#252ae5",
          "text": "#ffffff",
          "border": "#3137ff",
          "radius": 999,
          "shadow": {
            "x": 0,
            "y": 8,
            "blur": 24,
            "spread": -8,
            "color": "#3137ff",
            "alpha": 0.35
          }
        },
        "secondary": {
          "background": "transparent",
          "hover": "#e7e9ff",
          "text": "#090a12",
          "border": "#e7e9f0",
          "radius": 999,
          "shadow": "none"
        }
      },
      "cards": {
        "standard": {
          "background": "#ffffff",
          "text": "#090a12",
          "border": "#e7e9f0",
          "radius": 16,
          "shadow": "none"
        },
        "feature": {
          "background": "#171c86",
          "text": "#ffffff",
          "border": "#3137ff",
          "radius": 20,
          "shadow": {
            "x": 0,
            "y": 12,
            "blur": 32,
            "spread": -8,
            "color": "#000000",
            "alpha": 0.25
          }
        }
      },
      "effects": {
        "shadow": "0 8px 24px -8px rgba(17,18,44,0.18)",
        "blur": "blur(16px)"
      },
      "fonts": [
        {
          "family": "Space Grotesk",
          "role": "display"
        },
        {
          "family": "Space Grotesk",
          "role": "heading"
        },
        {
          "family": "Inter",
          "role": "body"
        },
        {
          "family": "Inter",
          "role": "cta"
        }
      ],
      "assets": {
        "logo": "/assets/logo.svg",
        "hero": "/assets/hero.webp"
      }
    }
  ],
  "x-portable-theme-version": 1,
  "x-import-limits": {
    "extension": ".json",
    "maxBytes": 1500000,
    "note": "Enforced by the editor upload flow before validation."
  },
  "x-foundations": [
    {
      "id": "meta",
      "path": "meta",
      "kind": "identity",
      "required": "meta.name (or legacy top-level name)",
      "description": "Theme identity. name is the only required identity field.",
      "keys": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "notes": "Trimmed; save UI caps at 80 chars."
        },
        {
          "key": "description",
          "type": "string",
          "required": false
        }
      ]
    },
    {
      "id": "colors",
      "path": "colors",
      "kind": "foundation",
      "required": false,
      "description": "Fifteen colour roles mapped to Socios tokens.",
      "keys": [
        {
          "key": "primary",
          "type": "hex",
          "description": "Brand / primary action colour.",
          "tokens": [
            "--button-primary",
            "--primary-foreground (fallback #ffffff)",
            "--ring",
            "--bg-brand",
            "--bg-info",
            "--border-brand",
            "--border-selected",
            "--bg-brand-accessible",
            "--text-brand",
            "--icon-brand"
          ]
        },
        {
          "key": "primaryHover",
          "type": "hex",
          "description": "Pressed/hover brand colour.",
          "tokens": [
            "--bg-brand-selected"
          ]
        },
        {
          "key": "primarySubtle",
          "type": "hex",
          "description": "Tinted brand surface.",
          "tokens": [
            "--bg-brand-subtle",
            "--bg-info-subtle"
          ]
        },
        {
          "key": "background",
          "type": "hex",
          "description": "App/screen background.",
          "tokens": [
            "--bg-screen",
            "--bg-unselected",
            "--bg-subtle"
          ]
        },
        {
          "key": "surface",
          "type": "hex",
          "description": "Cards, inputs and containers.",
          "tokens": [
            "--bg-container",
            "--bg-input",
            "--bg-container-translucent (92% mix)"
          ]
        },
        {
          "key": "strongSurface",
          "type": "hex",
          "description": "Inverse / feature surface.",
          "tokens": [
            "--bg-inverse",
            "--text-inverse (fallback chain)"
          ]
        },
        {
          "key": "primaryText",
          "type": "hex",
          "description": "Primary copy and icons.",
          "tokens": [
            "--text-primary",
            "--icon-primary",
            "--secondary-foreground"
          ]
        },
        {
          "key": "secondaryText",
          "type": "hex",
          "description": "Secondary copy and unselected icons.",
          "tokens": [
            "--text-subtle",
            "--icon-unselected"
          ]
        },
        {
          "key": "mutedText",
          "type": "hex",
          "description": "Disabled copy, icons and borders.",
          "tokens": [
            "--text-disabled",
            "--icon-disabled",
            "--border-disabled"
          ]
        },
        {
          "key": "textOnPrimary",
          "type": "hex",
          "description": "Text/icon on the primary colour.",
          "tokens": [
            "--text-on-brand",
            "--primary-foreground (fallback #ffffff)"
          ]
        },
        {
          "key": "textOnStrongSurface",
          "type": "hex",
          "description": "Text/icon on strongSurface.",
          "tokens": [
            "--text-inverse (fallback chain)"
          ]
        },
        {
          "key": "border",
          "type": "hex",
          "description": "Dividers and default borders.",
          "tokens": [
            "--border-subtle",
            "--border-unselected",
            "--border-divider"
          ]
        },
        {
          "key": "positive",
          "type": "hex",
          "description": "Success / price-up.",
          "tokens": [
            "--bg-success",
            "--bg-price-up",
            "--text-success",
            "--text-price-up",
            "--text-price-positive",
            "--border-success",
            "--border-price-up",
            "--icon-success",
            "--icon-price-up"
          ]
        },
        {
          "key": "negative",
          "type": "hex",
          "description": "Error / price-down.",
          "tokens": [
            "--bg-error",
            "--bg-price-down",
            "--text-error",
            "--text-price-down",
            "--border-error",
            "--icon-error"
          ]
