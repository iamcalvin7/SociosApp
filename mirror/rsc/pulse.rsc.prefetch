11:["$","$L1a",null,{"children":["$","main",null,{"data-page-container":"wide","className":"page-container","children":[["$","header",null,{"style":{"margin":"0 0 18px","display":"flex","flexDirection":"column","gap":4},"children":[["$","h1",null,{"className":"sr-only","children":"Pulse"}],["$","p",null,{"className":"sr-only","children":"The fan newswire — transfers, matches, tokens and club news, live."}]]}],["$","$L1b",null,{"stories":[{"id":"psg-armband-poll","category":"token","source":"Socios","headline":"$$PSG poll opens: vote on the captain's armband design for the cup final","blurb":"Token holders can now cast votes on three armband concepts. The winning design will be worn in the final and minted as a commemorative reward for every voter.","ago":"12m ago","agoMin":12,"token":"PSG","activity":1830},{"id":"app-prediction-streaks","category":"club","source":"Socios","headline":"Prediction streaks arrive in the app — six correct calls unlock a merch drop","blurb":"The new streak meter tracks consecutive correct match predictions across any competition. Hit six in a row and a limited merch reward unlocks automatically.","ago":"25m ago","agoMin":25,"activity":720},{"id":"bar-winger-medical","category":"transfer","source":"Fabrizio","kind":"media","headline":"Barça close to agreement for winger — medical booked","blurb":"Personal terms agreed on a five-year deal; clubs finalising add-on structure.","ago":"38m ago","agoMin":38,"token":"BAR","activity":4210},{"id":"sq-whale-thread","category":"token","source":"FanTokenWhale","kind":"social","handle":"@FanTokenWhale","headline":"Thread: three wallets moved 2.1M CHZ into Fan Tokens before the derby — here's what they bought","blurb":"On-chain breakdown of the weekend's biggest accumulation: the $INTER and $ACM books absorbed most of it, with a smaller $GAL position opened late Friday. Receipts in the thread.","ago":"52m ago","agoMin":52,"activity":3120},{"id":"city-possession-record","category":"match","source":"OptaJoe","kind":"media","headline":"City record 78% possession in derby first half","blurb":"Highest first-half share in a league derby since records began in 2003.","ago":"1h ago","agoMin":64,"token":"CITY","activity":960},{"id":"acm-burn-window","category":"token","source":"Socios","headline":"$$ACM matchday burn window opens at kick-off tonight","blurb":"A share of every stadium purchase burns $ACM for 90 minutes. Last derby's window retired 41,200 tokens from supply.","ago":"1h ago","agoMin":88,"token":"ACM","activity":2140},{"id":"sq-matchday-psg","category":"match","source":"Parc des Princes Live","kind":"social","handle":"@ParcLive","token":"PSG","headline":"Matchday atmosphere at the Parc is different tonight — armband vote results at half-time","blurb":"The ultras' end is already full an hour before kick-off. Club confirmed the winning armband design from the $PSG vote gets unveiled at the break.","ago":"2h ago","agoMin":130,"activity":1460},{"id":"juv-keeper-contract","category":"club","source":"Juventus","headline":"Academy keeper signs first professional contract","blurb":"The 18-year-old joins on a three-year deal after a standout youth season.","ago":"3h ago","agoMin":180,"token":"JUV","activity":310},{"id":"inter-derby-lineups","category":"match","source":"Inter","headline":"Derby della Madonnina: predicted line-ups and token-holder seat upgrades","blurb":"Both squads at full strength; $INTER holders can bid remaining VIP upgrades until 18:00 CET.","ago":"4h ago","agoMin":245,"token":"INTER","activity":1275},{"id":"gal-volume-spike","category":"token","source":"Chiliz Watch","kind":"media","headline":"$$GAL volume triples ahead of Istanbul derby weekend","blurb":"Trading volume hit a 90-day high as derby anticipation builds across the market.","ago":"5h ago","agoMin":300,"token":"GAL","activity":1890},{"id":"afc-third-kit-vote","category":"token","source":"Socios","headline":"$$AFC holders choose next season's third-kit colourway","blurb":"Four concepts from the club's design studio; voting closes Friday.","ago":"6h ago","agoMin":380,"token":"AFC","activity":2760},{"id":"sq-derby-tifo","category":"club","source":"UltrasMilano","kind":"social","handle":"@UltrasMilano","headline":"Derby eve tradition: the San Siro north end unveils its tifo budget — and it's the biggest yet","blurb":"Curva Nord's fundraising page closed at a record total. The design stays secret until the players walk out, as always.","ago":"7h ago","agoMin":430,"activity":2210},{"id":"spurs-boot-room","category":"club","source":"Tottenham","headline":"Inside the boot room: kit staff's matchday rituals revealed","blurb":"A behind-the-scenes feature filmed across the north-London derby week.","ago":"8h ago","agoMin":480,"token":"SPURS","activity":205},{"id":"media-engagement-report","category":"token","source":"SportsPro","kind":"media","headline":"Fan engagement report: token-linked voting participation up 38% year on year","blurb":"The annual report tracks ballots across the major fan-token platforms; matchday-adjacent votes drove most of the growth.","ago":"9h ago","agoMin":540,"activity":640},{"id":"nap-striker-release","category":"transfer","source":"Di Marzio","kind":"media","headline":"Napoli trigger release clause for Argentine striker","blurb":"A €38m clause activated; player expected in Italy early next week.","ago":"10h ago","agoMin":610,"token":"NAP","activity":3390},{"id":"mengo-libertadores","category":"match","source":"Flamengo","headline":"Mengão seal Libertadores semi-final spot with stoppage-time winner","blurb":"A 94th-minute header sends the Maracanã into raptures and the club through.","ago":"12h ago","agoMin":735,"token":"MENGO","activity":5120},{"id":"atm-staking-live","category":"token","source":"Socios","headline":"$$ATM staking pool live: lock tokens for derby-day rewards","blurb":"Stakers earn loyalty multipliers and a raffle entry for signed shirts.","ago":"14h ago","agoMin":845,"token":"ATM","activity":980},{"id":"asr-captain-extension","category":"club","source":"AS Roma","headline":"Captain signs two-year extension through 2028","blurb":"The skipper commits his peak years to the Giallorossi project.","ago":"16h ago","agoMin":985,"token":"ASR","activity":1445},{"id":"sq-staking-guide","category":"token","source":"CHZ Yield Girl","kind":"social","handle":"@chzyieldgirl","headline":"I compared every Fan Token staking pool so you don't have to — APR, lockups, hidden perks","blurb":"Full spreadsheet in the post: headline APR is not the whole story once you count loyalty multipliers and raffle entries.","ago":"18h ago","agoMin":1080,"activity":1980},{"id":"arg-friendly-tokens","category":"match","source":"AFA","headline":"Argentina announce two June friendlies — token-holder presale confirmed","blurb":"$$ARG holders get a 48-hour ticket presale window for both fixtures.","ago":"19h ago","agoMin":1160,"token":"ARG","activity":2230},{"id":"chz-oracle-upgrade","category":"token","source":"Chiliz","headline":"Chiliz Chain price-oracle upgrade cuts feed latency by half","blurb":"Faster on-chain pricing for every Fan Token pair on the network.","ago":"22h ago","agoMin":1340,"activity":760},{"id":"por-keeper-transfer","category":"transfer","source":"Record PT","kind":"media","headline":"Portugal starlet keeper linked with Premier League move","blurb":"Three clubs monitoring; his agent flew to London on Tuesday.","ago":"Yesterday","agoMin":1680,"token":"POR","activity":1510},{"id":"bar-camp-nou-return","category":"club","source":"FC Barcelona","headline":"Camp Nou return date confirmed for league classic","blurb":"The rebuilt stadium reopens at full capacity for the season's marquee fixture.","ago":"Yesterday","agoMin":1820,"token":"BAR","activity":6040},{"id":"psg-ucl-rotation","category":"match","source":"L'Équipe","kind":"media","headline":"PSG plan heavy rotation for midweek Champions League tie","blurb":"Six changes expected with the domestic title already sealed.","ago":"Yesterday","agoMin":2050,"token":"PSG","activity":890},{"id":"city-fan-vote-mural","category":"token","source":"Socios","headline":"$$CITY vote decides the new Etihad mural — four artists shortlisted","blurb":"The winning artist paints the east-stand mural during the summer break.","ago":"Yesterday","agoMin":2400,"token":"CITY","activity":1120},{"id":"juv-transfer-midfielder","category":"transfer","source":"Romano","kind":"media","headline":"Juventus open talks for Brazilian midfielder — here we go soon?","blurb":"Verbal agreement close; final fee negotiation scheduled this week.","ago":"Yesterday","agoMin":2660,"token":"JUV","activity":4870},{"id":"inter-women-title","category":"club","source":"Inter","headline":"Inter Women clinch the title with two games to spare","blurb":"A 3-0 away win seals the club's first women's Scudetto.","ago":"2d ago","agoMin":3050,"token":"INTER","activity":2380},{"id":"nap-scudetto-parade","category":"club","source":"Napoli","headline":"Scudetto parade route announced — waterfront celebration Sunday","blurb":"The open-top bus route runs the full Lungomare; 200k fans expected.","ago":"2d ago","agoMin":3420,"token":"NAP","activity":3660},{"id":"afc-injury-update","category":"match","source":"Arsenal","headline":"Double injury boost ahead of the title run-in","blurb":"Both first-team starters return to full training this week.","ago":"2d ago","agoMin":3780,"token":"AFC","activity":1980},{"id":"gal-nft-drop","category":"token","source":"Socios","headline":"$$GAL derby-moment collectibles drop sells out in nine minutes","blurb":"5,000 minted moments from the derby win; secondary listings already live.","ago":"2d ago","agoMin":4100,"token":"GAL","activity":2540}]}]]}]}]
